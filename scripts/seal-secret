#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 3 ]; then
  echo "Usage: seal-secret SECRET_NAME NAMESPACE KEY1=VALUE1 [KEY2=VALUE2 ...]" >&2
  exit 1
fi

SECRET_NAME=$1
NAMESPACE=$2
shift 2

LITERALS=()
for arg in "$@"; do
  LITERALS+=("--from-literal=$arg")
done

kubectl create secret generic "$SECRET_NAME" "${LITERALS[@]}" \
  --namespace="$NAMESPACE" \
  --dry-run=client -o yaml | kubeseal \
  --controller-name=sealed-secrets \
  --controller-namespace=sealed-secrets \
  --namespace="$NAMESPACE" \
  -o yaml
