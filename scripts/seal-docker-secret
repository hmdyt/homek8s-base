#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 3 ]; then
  echo "Usage: seal-docker-secret SECRET_NAME NAMESPACE docker-server=SERVER docker-username=USER docker-password=PASS" >&2
  exit 1
fi

SECRET_NAME=$1
NAMESPACE=$2
shift 2

DOCKER_ARGS=()
for arg in "$@"; do
  key="${arg%%=*}"
  value="${arg#*=}"
  DOCKER_ARGS+=("--$key=$value")
done

kubectl create secret docker-registry "$SECRET_NAME" \
  "${DOCKER_ARGS[@]}" \
  --namespace="$NAMESPACE" \
  --dry-run=client -o yaml | kubeseal \
  --controller-name=sealed-secrets \
  --controller-namespace=sealed-secrets \
  --namespace="$NAMESPACE" \
  -o yaml
